{
  "protect": [
    {
      "paths": [
        ".github/workflows/**"
      ],
      "decision": "deny",
      "reason": "Claude's GitHub token can't push workflow changes. Put the proposed file in docs/ci/ and track it in docs/PROJECT.md (CLAUDE.md).",
      "gate": true
    },
    {
      "paths": [
        "tests/corpus/ok/*.json"
      ],
      "decision": "deny",
      "reason": "Goldens are the spec of the timeline and are generated: change the parser, then `mise run bless`, and review the diff as a change in how songs play."
    },
    {
      "paths": [
        "tests/engine/{vectors,timelines}.json"
      ],
      "decision": "deny",
      "reason": "Engine fixtures are generated: `UPDATE=1 swift test --package-path mac --filter VCTTests.Vectors`, then review the diff as the phones' contract."
    },
    {
      "paths": [
        "schemas/session.schema.json",
        "schemas/examples/session/"
      ],
      "decision": "deny",
      "reason": "Generated by scripts/gen-session-schema.py: edit that, then `mise run gen:session-schema`."
    },
    {
      "paths": [
        "build/",
        "out/",
        "mac/build/",
        "mac/.build/",
        "app/dist/",
        "app/node_modules/",
        "mac/StageDisplay.xcodeproj/"
      ],
      "decision": "deny",
      "reason": "Build output. Change the source and rebuild with the mise task."
    }
  ],
  "checks": [
    {
      "when": [
        "mise.toml"
      ],
      "run": "mise tasks >/dev/null"
    },
    {
      "when": [
        "mac/",
        "tests/",
        "docs/format.md",
        "docs/guide.md"
      ],
      "run": "mise run vet:swift"
    },
    {
      "when": [
        "app/",
        "tests/engine/",
        "tests/transport/"
      ],
      "run": "mise run vet:app"
    },
    {
      "when": [
        "mac/",
        "tests/",
        "examples/",
        "docs/format.md",
        "docs/guide.md"
      ],
      "run": "mise run test"
    },
    {
      "when": [
        "app/",
        "tests/engine/",
        "tests/transport/"
      ],
      "run": "mise run test:app"
    },
    {
      "when": [
        "mac/App/",
        "mac/project.yml"
      ],
      "run": "mise run build:mac-app",
      "platforms": [
        "darwin"
      ],
      "tier": "final"
    },
    {
      "when": [
        "tools/stems/"
      ],
      "run": "mise run stems:test"
    },
    {
      "when": [
        "tools/draft/"
      ],
      "run": "mise run draft:test"
    },
    {
      "when": [
        "schemas/",
        "scripts/session-schema/",
        "scripts/gen-session-schema.py"
      ],
      "run": "mise run check:schemas"
    },
    {
      "when": [
        "docs/**/*.md"
      ],
      "if_contains": "```mermaid",
      "run": "mise run check:diagrams"
    },
    {
      "when": [
        "mac/Sources/BandServer/",
        "mac/Sources/BandsyncCommand/",
        "app/",
        "schemas/",
        "scripts/e2e-bandsync.py"
      ],
      "run": "mise run test:e2e",
      "tier": "final",
      "platforms": [
        "darwin"
      ]
    }
  ],
  "forbid": [],
  "co_change": [
    {
      "path": "mac/Sources/VCT/Types.swift",
      "diff_matches": "^[+-].*\\b(headerNames|modifierKeys|flagNames)\\b",
      "require": [
        "docs/format.md",
        "docs/guide.md"
      ],
      "message": "A format change updates both docs in the same commit"
    }
  ],
  "registered_in": [
    {
      "new": [
        "scripts/*.{sh,py}"
      ],
      "file": "mise.toml",
      "message": "Every script has a task in mise.toml"
    }
  ],
  "notes": [
    {
      "when": [
        "tests/corpus/ok/*.json",
        "tests/engine/{vectors,timelines}.json"
      ],
      "message": "Goldens changed (review as a change in how songs play)"
    },
    {
      "when": [
        "tests/transport/vectors.json"
      ],
      "message": "Song clock vectors changed (the contract between bandsync and the phones)"
    },
    {
      "when": [
        "tests/chordpro/",
        "tests/sheet/",
        "tests/sections/"
      ],
      "message": "Import/export fixtures changed (review as a change in what importing or exporting produces)"
    }
  ],
  "verifier_notes": ".claude/harness-verifier.md",
  "gate": {
    "baseline_setup": "mise trust >/dev/null 2>&1; mise run app:deps"
  }
}
